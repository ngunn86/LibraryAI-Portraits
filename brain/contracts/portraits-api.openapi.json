{
 "openapi": "3.1.0",
 "info": {
  "title": "Nexus Portraits API",
  "version": "1.0.0-draft.3",
  "summary": "What the library reads from the portraits tool, and the decisions and requests it sends back.",
  "description": "Defined by this project and adopted by the library (D-37). Draft for T-08, 2026-10-19.\n\n- **Pull only** (D-44): the library reads the change feed on its own schedule; the tool never calls the library.\n- **One key** (D-44) for the library, for reading and sending. Made and switched off by the owner; stored only as a hash.\n- **Requests are handled right away** (D-44): a request answers 202, and its result appears in the change feed.\n- The library keeps its own copy of every file it pulls (D-42); each file carries its SHA-256.\n- Conventions mirror the library's own API (Rev1 `brain/contracts/api.openapi.json`): bearer keys, the same error object, the same change-feed pattern.\n- Within v1, changes are additive only: new optional fields and new routes. Response objects may gain fields; readers must ignore unknown ones."
 },
 "servers": [
  {
   "url": "https://portraits.example.up.railway.app",
   "description": "Illustrative; the real address is set at deploy (T-23)."
  }
 ],
 "security": [
  {
   "libraryKey": []
  }
 ],
 "tags": [
  {
   "name": "teachers"
  },
  {
   "name": "portraits"
  },
  {
   "name": "changes"
  },
  {
   "name": "decisions"
  },
  {
   "name": "requests"
  },
  {
   "name": "health"
  }
 ],
 "paths": {
  "/api/v1/health": {
   "get": {
    "tags": [
     "health"
    ],
    "summary": "Is the service up",
    "security": [],
    "operationId": "health",
    "description": "No key. Used by the host's healthcheck and the harness's smoke tests.",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/teachers": {
   "get": {
    "tags": [
     "teachers"
    ],
    "summary": "All teachers",
    "operationId": "listTeachers",
    "description": "Every teacher the tool knows, including those with no portrait yet and those who have left the list (`on_list` false).",
    "parameters": [
     {
      "$ref": "#/components/parameters/after"
     },
     {
      "$ref": "#/components/parameters/limit"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TeacherPage"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/teachers/{teacher_id}": {
   "get": {
    "tags": [
     "teachers"
    ],
    "summary": "One teacher, with their portraits",
    "operationId": "getTeacher",
    "parameters": [
     {
      "$ref": "#/components/parameters/teacher_id"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Teacher"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/portraits": {
   "get": {
    "tags": [
     "portraits"
    ],
    "summary": "Portraits, optionally by teacher or status",
    "operationId": "listPortraits",
    "parameters": [
     {
      "name": "teacher_id",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
       "description": "Stable slug (D-22), e.g. `charles-fillmore`.",
       "examples": [
        "charles-fillmore"
       ]
      }
     },
     {
      "name": "status",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "waiting",
        "approved",
        "turned_down",
        "replaced"
       ]
      }
     },
     {
      "$ref": "#/components/parameters/after"
     },
     {
      "$ref": "#/components/parameters/limit"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PortraitPage"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/portraits/{portrait_id}": {
   "get": {
    "tags": [
     "portraits"
    ],
    "summary": "One portrait: record, rights and files",
    "operationId": "getPortrait",
    "parameters": [
     {
      "$ref": "#/components/parameters/portrait_id"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Portrait"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/portraits/{portrait_id}/files/{kind}": {
   "get": {
    "tags": [
     "portraits"
    ],
    "summary": "Download one file",
    "operationId": "getPortraitFile",
    "description": "Redirects to a signed link to the bucket, valid for 15 minutes. Call this route again for a fresh link.",
    "parameters": [
     {
      "$ref": "#/components/parameters/portrait_id"
     },
     {
      "name": "kind",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "original",
        "original-view",
        "white-1000",
        "white-500",
        "bw-1000",
        "bw-500",
        "enhanced",
        "mask"
       ]
      }
     }
    ],
    "responses": {
     "302": {
      "description": "Redirect to the signed download.",
      "headers": {
       "Location": {
        "schema": {
         "type": "string",
         "format": "uri"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/portraits/{portrait_id}/history": {
   "get": {
    "tags": [
     "portraits"
    ],
    "summary": "Everything that happened to a portrait",
    "operationId": "getPortraitHistory",
    "parameters": [
     {
      "$ref": "#/components/parameters/portrait_id"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/History"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/changes": {
   "get": {
    "tags": [
     "changes"
    ],
    "summary": "What changed since",
    "operationId": "listChanges",
    "description": "Every change since a point, in sequence order. The first call passes `since`; each later call passes the previous `next_cursor` as `after` (one of the two is required).",
    "parameters": [
     {
      "name": "since",
      "in": "query",
      "schema": {
       "type": "string",
       "format": "date-time"
      },
      "description": "First call: changes after this time."
     },
     {
      "$ref": "#/components/parameters/after"
     },
     {
      "$ref": "#/components/parameters/limit"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChangeFeed"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "410": {
      "$ref": "#/components/responses/CursorTooOld"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/decisions": {
   "post": {
    "tags": [
     "decisions"
    ],
    "summary": "Send a decision about a portrait",
    "operationId": "sendDecision",
    "description": "Approve, turn down (with a reason), choose the main portrait, or correct a value (D-38). Safe to resend: a repeated `decision_id` is applied once.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Decision"
       },
       "examples": {
        "turn_down": {
         "value": {
          "decision_id": "lib-dec-0042",
          "portrait_id": "charles-fillmore-2",
          "kind": "turn_down",
          "reason": "quality",
          "note": "Too blurred",
          "by": "admin-1",
          "at": "2026-11-02T14:05:00Z"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DecisionResult"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/requests": {
   "post": {
    "tags": [
     "requests"
    ],
    "summary": "Ask for work on a teacher",
    "operationId": "sendRequest",
    "description": "Try again, another original, or try a link (IN-06). Handled right away by the worker (D-44). Safe to resend: a repeated `request_id` returns the existing request.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NewRequest"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "Queued.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Request"
        }
       }
      }
     },
     "200": {
      "description": "Already known: the existing request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Request"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   },
   "get": {
    "tags": [
     "requests"
    ],
    "summary": "Requests, optionally by status",
    "operationId": "listRequests",
    "parameters": [
     {
      "name": "status",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "queued",
        "working",
        "done",
        "refused"
       ]
      }
     },
     {
      "$ref": "#/components/parameters/after"
     },
     {
      "$ref": "#/components/parameters/limit"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RequestPage"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "422": {
      "$ref": "#/components/responses/Invalid"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  },
  "/api/v1/requests/{request_id}": {
   "get": {
    "tags": [
     "requests"
    ],
    "summary": "One request",
    "operationId": "getRequest",
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Request"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/KeyOff"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "429": {
      "$ref": "#/components/responses/RateLimited"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "libraryKey": {
    "type": "http",
    "scheme": "bearer",
    "description": "The library's key (D-44): `Authorization: Bearer <key>`. One key reads and sends. Stored only as a hash; can be switched off or replaced without a deploy (HT-20)."
   }
  },
  "parameters": {
   "after": {
    "name": "after",
    "in": "query",
    "schema": {
     "type": "string"
    },
    "description": "The opaque `next_cursor` of the previous page."
   },
   "limit": {
    "name": "limit",
    "in": "query",
    "schema": {
     "type": "integer",
     "minimum": 1,
     "maximum": 500,
     "default": 100
    }
   },
   "teacher_id": {
    "name": "teacher_id",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
     "description": "Stable slug (D-22), e.g. `charles-fillmore`.",
     "examples": [
      "charles-fillmore"
     ]
    }
   },
   "portrait_id": {
    "name": "portrait_id",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+$",
     "description": "`<teacher_id>-<n>`, never reused (OUT-11).",
     "examples": [
      "charles-fillmore-1"
     ]
    }
   }
  },
  "responses": {
   "KeyOff": {
    "description": "The key is missing, unknown or switched off.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "key_off",
       "message": "The key is missing, unknown or switched off."
      }
     }
    }
   },
   "NotFound": {
    "description": "No such teacher, portrait, file or request.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "not_found",
       "message": "No such teacher, portrait, file or request."
      }
     }
    }
   },
   "Conflict": {
    "description": "The decision or request can't apply in the portrait's current state, or its id was reused with different content.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "conflict",
       "message": "The decision or request can't apply in the portrait's current state, or its id was reused with different content."
      }
     }
    }
   },
   "CursorTooOld": {
    "description": "That point in the change feed is older than 30 days; re-sync from /teachers and /portraits.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "cursor_too_old",
       "message": "That point in the change feed is older than 30 days; re-sync from /teachers and /portraits."
      }
     }
    }
   },
   "Invalid": {
    "description": "A field is missing or invalid; `field` names it.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "invalid",
       "message": "A field is missing or invalid; `field` names it."
      }
     }
    }
   },
   "RateLimited": {
    "description": "Too many calls; try again after Retry-After seconds.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "kind": "rate_limited",
       "message": "Too many calls; try again after Retry-After seconds."
      }
     }
    },
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer",
       "minimum": 1
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "key_off",
       "out_of_scope",
       "not_found",
       "invalid",
       "conflict",
       "cursor_too_old",
       "rate_limited"
      ]
     },
     "message": {
      "type": "string",
      "description": "Plain words, for a person."
     },
     "field": {
      "type": "string",
      "description": "For `invalid`: the field that failed, as a JSON pointer."
     }
    },
    "required": [
     "kind",
     "message"
    ],
    "description": "The same shape and kinds as the library's own API (Rev1 `api.openapi.json`, `Error`), plus `conflict`. key_off 401, out_of_scope 403, not_found 404, conflict 409, cursor_too_old 410, invalid 400 or 422, rate_limited 429 (with Retry-After)."
   },
   "Page": {
    "type": "object",
    "properties": {
     "next_cursor": {
      "oneOf": [
       {
        "type": "string",
        "description": "Opaque; pass as `after`."
       },
       {
        "type": "null"
       }
      ]
     },
     "more": {
      "type": "boolean"
     }
    },
    "required": [
     "next_cursor",
     "more"
    ]
   },
   "PortraitSearch": {
    "type": "object",
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "not_yet",
       "found",
       "none_found"
      ],
      "description": "not_yet: not searched yet; found: at least one portrait made; none_found: searched, and no candidate passed."
     },
     "last_searched": {
      "oneOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "state",
     "last_searched"
    ],
    "description": "Where the search for this teacher's portraits stands, so the library can tell 'coming' from 'none exists'."
   },
   "TeacherSummary": {
    "type": "object",
    "properties": {
     "teacher_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug (D-22), e.g. `charles-fillmore`.",
      "examples": [
       "charles-fillmore"
      ]
     },
     "name": {
      "type": "string"
     },
     "born": {
      "oneOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "died": {
      "oneOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "wikidata_qid": {
      "oneOf": [
       {
        "type": "string",
        "pattern": "^Q[0-9]+$"
       },
       {
        "type": "null"
       }
      ]
     },
     "lcnaf_id": {
      "oneOf": [
       {
        "type": "string",
        "pattern": "^n[a-z]?[0-9]+$"
       },
       {
        "type": "null"
       }
      ],
      "description": "The teacher's Library of Congress name authority id (id.loc.gov), when known or found (IN-13). Helps the library match its people."
     },
     "on_list": {
      "type": "boolean"
     },
     "portraits": {
      "type": "object",
      "properties": {
       "waiting": {
        "type": "integer",
        "minimum": 0
       },
       "approved": {
        "type": "integer",
        "minimum": 0
       },
       "turned_down": {
        "type": "integer",
        "minimum": 0
       },
       "replaced": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "waiting",
       "approved",
       "turned_down",
       "replaced"
      ],
      "description": "Counts by status."
     },
     "main_portrait_id": {
      "oneOf": [
       {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+$",
        "description": "`<teacher_id>-<n>`, never reused (OUT-11).",
        "examples": [
         "charles-fillmore-1"
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "portrait_search": {
      "$ref": "#/components/schemas/PortraitSearch"
     },
     "record_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Goes up by one whenever the record changes."
     }
    },
    "required": [
     "teacher_id",
     "name",
     "born",
     "died",
     "wikidata_qid",
     "on_list",
     "portraits",
     "main_portrait_id",
     "portrait_search",
     "record_version",
     "lcnaf_id"
    ]
   },
   "Teacher": {
    "allOf": [
     {
      "$ref": "#/components/schemas/TeacherSummary"
     },
     {
      "type": "object",
      "properties": {
       "aliases": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "dates_from": {
        "type": "string",
        "enum": [
         "list",
         "wikidata",
         "both"
