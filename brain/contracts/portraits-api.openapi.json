      "type": "boolean"
     }
    },
    "required": [
     "since",
     "until",
     "changes",
     "next_cursor",
     "more"
    ],
    "description": "The feed is kept for 30 days. An older `since` or `after` answers 410; the library then re-syncs from /teachers and /portraits. Same pattern as the library's own /changes."
   },
   "Decision": {
    "type": "object",
    "properties": {
     "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Given by the library. Sending the same decision twice is safe: it is applied once."
     },
     "portrait_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-[0-9]+$",
      "description": "`<teacher_id>-<n>`, never reused (OUT-11).",
      "examples": [
       "charles-fillmore-1"
      ]
     },
     "kind": {
      "type": "string",
      "enum": [
       "approve",
       "turn_down",
       "set_main",
       "correct"
      ],
      "description": "approve: a waiting portrait goes live in the library. Approving a better copy (one with `replaces`) is the swap: the old portrait becomes `replaced` (PIP-17). turn_down: a waiting or approved portrait; needs `reason`. set_main: an approved portrait becomes the teacher's main one; the previous main is unset. correct: replaces the tool's value of `field` with `value`; never overwritten by a later run (PIP-18)."
     },
     "reason": {
      "type": "string",
      "enum": [
       "not_this_teacher",
       "do_not_use",
       "quality",
       "other"
      ],
      "description": "For turn_down. not_this_teacher and do_not_use mean no copy of the photograph ever comes back; quality and other allow one clearly better copy (PIP-17)."
     },
     "field": {
      "type": "string",
      "enum": [
       "approx_date",
       "best_known"
      ],
      "description": "For correct."
     },
     "value": {
      "description": "For correct: a year (integer) or null for approx_date; a boolean for best_known."
     },
     "note": {
      "type": "string",
      "maxLength": 2000
     },
     "by": {
      "type": "string",
      "maxLength": 100,
      "description": "A label for the admin who decided. Never an email or other personal detail."
     },
     "at": {
      "type": "string",
      "format": "date-time"
     }
    },
    "additionalProperties": false,
    "required": [
     "decision_id",
     "portrait_id",
     "kind",
     "by",
     "at"
    ],
    "allOf": [
     {
      "if": {
       "properties": {
        "kind": {
         "const": "turn_down"
        }
       }
      },
      "then": {
       "required": [
        "reason"
       ]
      }
     },
     {
      "if": {
       "properties": {
        "kind": {
         "const": "correct"
        }
       }
      },
      "then": {
       "required": [
        "field",
        "value"
       ]
      }
     }
    ]
   },
   "DecisionResult": {
    "type": "object",
    "properties": {
